#!/usr/bin/env bash
# pre-push: run the eval suite of every skill this push changes.
#
# A skill is a prompt, so an edit to SKILL.md is a config change with nothing
# to catch a regression. This runs `claude plugin eval` on the pusher's own
# Claude login (subscription usage, not API credits) before the push leaves.
#
# Enable once per clone:   git config core.hooksPath scripts/hooks
# Skip one push:           SKIP_EVALS=1 git push   (or git push --no-verify)
# More runs per case:      EVAL_RUNS=3 git push    (default 1: a smoke gate)
#
# A skill whose pushed content already has a passing entry in
# evals-history/<skill>.jsonl (publish-skill records one before committing) is
# not run again: that entry is the evidence for exactly this content.

set -uo pipefail

[ "${SKIP_EVALS:-}" = "1" ] && { echo "pre-push: SKIP_EVALS=1, evals skipped"; exit 0; }
command -v claude >/dev/null 2>&1 || { echo "pre-push: claude not on PATH, evals skipped"; exit 0; }

root=$(git rev-parse --show-toplevel)
cd "$root" || exit 0
[ -x scripts/eval-run.sh ] || [ -f scripts/eval-run.sh ] || exit 0
zero=0000000000000000000000000000000000000000

todo=""
while read -r _lref lsha _rref rsha; do
  [ -z "${lsha:-}" ] && continue                        # blank line
  [ "$lsha" = "$zero" ] && continue                     # branch deletion
  if [ "$rsha" = "$zero" ]; then                        # new branch: diff against main
    base=$(git merge-base "$lsha" origin/main 2>/dev/null || git merge-base "$lsha" main 2>/dev/null) || continue
  else
    base=$rsha
  fi
  for s in $(git diff --name-only "$base" "$lsha" -- 'skills/*/SKILL.md' 'skills/*/evals/**' | cut -d/ -f2 | sort -u); do
    git cat-file -e "$lsha:skills/$s/evals" 2>/dev/null || continue
    tree=$(git rev-parse "$lsha:skills/$s")
    if git show "$lsha:evals-history/$s.jsonl" 2>/dev/null | grep "\"tree\":\"$tree\"" | grep -q '"passed":true'; then
      echo "pre-push: $s ${tree:0:7} already has a passing recorded eval, not re-running"
      continue
    fi
    case " $todo " in *" $s "*) ;; *) todo="$todo $s" ;; esac
  done
done

[ -z "${todo// /}" ] && exit 0

status=0
for s in $todo; do
  bash scripts/eval-run.sh "$s" || status=1
done

if [ "$status" != 0 ]; then
  echo "pre-push: eval regression, push blocked. Fix, or SKIP_EVALS=1 to override."
fi
exit $status
